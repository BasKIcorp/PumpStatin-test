{
  "name": "pumpstation-base",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "dev:local": "powershell -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "dev:web": "pnpm --filter @pumpstation/web dev",
    "dev:web:5180": "pnpm --filter @pumpstation/web dev --host 127.0.0.1 --port 5180 --strictPort",
    "dev:api": "cd apps/api && uv run uvicorn app.main:app --reload --host 127.0.0.1 --port 8000",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test:api": "cd apps/api && uv run python -m pytest -q",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "1.49.1"
  }
}
